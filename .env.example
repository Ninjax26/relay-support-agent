# Demo mode needs no key. Export these in your terminal to enable live mode.
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
# Optional alternative provider:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=8000
RELAY_WORKERS=2
RELAY_QUEUE_CAPACITY=100
# Optional: separate database per local workspace/server.
# RELAY_DB_PATH=data/another.sqlite3

# Live retrieval: bm25 (offline default), semantic, or hybrid. Demo always uses BM25.
# Semantic/hybrid require GEMINI_API_KEY even when generation uses OpenAI.
RELAY_RETRIEVAL_MODE=bm25

# Optional local test ticket connector. Prefer python3 scripts/run_sandbox.py,
# which generates a shared credential in memory. Leave empty for local-only tickets.
RELAY_TICKET_URL=
RELAY_TICKET_TOKEN=

# Hosted workspace settings. Configure actual values in the hosting environment.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# RELAY_PUBLIC_ORIGIN=https://your-relay-domain
RELAY_DAILY_LIVE_LIMIT=8
